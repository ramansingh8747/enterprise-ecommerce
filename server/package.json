{
  "name": "server",
  "version": "1.0.0",
  "description": "Enterprise E-Commerce Backend API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rmdir /s /q dist",
    "test": "npm run test:media:e2e:seeded",
    "test:variant:e2e": "ts-node --transpile-only scripts/e2e-variant.smoke.ts",
    "test:variant:e2e:seeded": "ts-node --transpile-only scripts/run-variant-e2e.ts",
    "test:media:validators": "ts-node --transpile-only scripts/e2e-media.validators.ts",
    "test:media:service": "ts-node --transpile-only scripts/e2e-media.service.ts",
    "test:media:e2e": "ts-node --transpile-only scripts/e2e-media.smoke.ts",
    "test:media:e2e:seeded": "ts-node --transpile-only scripts/run-media-e2e.ts",
    "test:inventory:validators": "ts-node --transpile-only scripts/e2e-inventory.validators.ts",
    "test:inventory:service": "ts-node --transpile-only scripts/e2e-inventory.service.ts",
    "test:inventory:e2e": "ts-node --transpile-only scripts/e2e-inventory.smoke.ts",
    "test:inventory:e2e:seeded": "ts-node --transpile-only scripts/run-inventory-e2e.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "ecommerce",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
